# LLM 供應商：ollama（預設，local）或 openai
LLM_PROVIDER=ollama

# Ollama（LLM_PROVIDER=ollama 時使用）
# 預設 qwen3:8b：prompt 配方是針對它調的（think-off + 指令置尾）；換模型需重驗
# 位址用 127.0.0.1 不用 localhost：Windows 上 localhost 先試 IPv6 ::1，每次多等約 2 秒
# 才 fallback 到 IPv4（同機實測 2.0s vs 0.016s）。要用 localhost 就在這裡改回來
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# OpenAI（LLM_PROVIDER=openai 時必填，否則啟動即失敗）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Telegram Bot（跑 bot 前填入；向 @BotFather 申請）
TELEGRAM_BOT_TOKEN=

# Tavily 搜尋 API（F13 查無時網搜補資料用；免費額度 1000 次/月，缺此 key 會 fail fast）
# 2026/08/23 Ryan 決定「先不申請、補查功能暫時關著」：留空是刻意的預設狀態，不是待辦。
# 空值只關掉 `python -m rag.backfill`（3.8 秒內帶訊息退出）；查詢／miss_log 記錄完全不受影響。
# 之後想開啟：填 key（app.tavily.com）→ 跑一次 backfill 看 requests=／stored=。決策見 vault DECISIONS D11
TAVILY_API_KEY=

# Embedding 模型（中文檢索，local sentence-transformers；換 e5 系列會自動補 query:/passage: 前綴）
EMBEDDING_MODEL=BAAI/bge-m3

# 資料路徑
OFFER_RADAR_DB=data/offers.db
CHROMA_PATH=data/chroma

# RAG 查詢 API（bot 呼叫用）
API_BASE_URL=http://localhost:8000
