# LLM 供應商：ollama（預設，local）或 openai
LLM_PROVIDER=ollama

# Ollama（LLM_PROVIDER=ollama 時使用）
# 預設 qwen3:8b：prompt 配方是針對它調的（think-off + 指令置尾）；換模型需重驗
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# OpenAI（LLM_PROVIDER=openai 時必填，否則啟動即失敗）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Telegram Bot（跑 bot 前填入；向 @BotFather 申請）
TELEGRAM_BOT_TOKEN=

# Embedding 模型（中文檢索，local sentence-transformers；換 e5 系列會自動補 query:/passage: 前綴）
EMBEDDING_MODEL=BAAI/bge-m3

# 資料路徑
DATABASE_PATH=data/offers.db
CHROMA_PATH=data/chroma

# RAG 查詢 API（bot 呼叫用）
API_BASE_URL=http://localhost:8000
