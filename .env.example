# LLM 供應商：ollama（預設，local）或 openai
LLM_PROVIDER=ollama

# Ollama（LLM_PROVIDER=ollama 時使用）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI（LLM_PROVIDER=openai 時必填，否則啟動即失敗）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Telegram Bot（F6 前填入；向 @BotFather 申請）
TELEGRAM_BOT_TOKEN=

# 資料路徑
DATABASE_PATH=data/offers.db
CHROMA_PATH=data/chroma

# RAG 查詢 API（bot 呼叫用）
API_BASE_URL=http://localhost:8000
